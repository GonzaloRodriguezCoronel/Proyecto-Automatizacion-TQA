# Copia este archivo como .env; NO publiques contraseñas ni claves.
APP_HOST=127.0.0.1
APP_PORT=8022
# Direcciones LOCALES del sistema minero (solo si deseas probar CIARA)
CIARA_API_URL=http://127.0.0.1:8000
CIARA_ML_URL=http://127.0.0.1:8001

# Para enviar reportes reales (si no configuras SMTP, los reportes se guardan para descargar)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false
SMTP_STARTTLS=true

# IA real opcional (sin clave, la aplicación muestra propuestas de reglas y Gherkin sin IA)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# En v5 la interfaz decide por ejecucion si Chrome es integrado o visible.
# Esta variable solo aplica a llamadas antiguas directas a run_side_test.
SELENIUM_HEADLESS=true
# Espera en milisegundos entre pasos para poder observar la demostracion (0-3000).
SELENIUM_STEP_DELAY_MS=750

# v7: sitio adicional autorizado, por ejemplo un frontend Angular local
# TQA_WEB_NAME=Frontend de pruebas
# TQA_WEB_URL=http://127.0.0.1:4200

# Opcional: si la web de CIARÁ usa otro puerto que su API,
# descomenta y cambia estas dos líneas por la URL verdadera del frontend.
# TQA_WEB_NAME=CIARÁ Web
# TQA_WEB_URL=http://127.0.0.1:4200

# Credenciales de una cuenta autorizada de PRUEBAS de CIARÁ.
# Configúralas con CONFIGURAR_ACCESO_CIARA.bat (no las publiques en GitHub).
CIARA_TEST_USERNAME=
CIARA_TEST_PASSWORD=
